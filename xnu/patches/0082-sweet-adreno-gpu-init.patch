diff -uNr xnu-buildtree/orig/xnu/iokit/Kernel/arm/SweetGPU.cpp xnu-buildtree/tree/xnu/iokit/Kernel/arm/SweetGPU.cpp
--- a/iokit/Kernel/arm/SweetGPU.cpp
+++ b/iokit/Kernel/arm/SweetGPU.cpp
@@ -0,0 +1,272 @@
+/*
+ * SweetGPU.cpp: Adreno 618 bring-up for Snapdragon 732G.
+ */
+#include "SweetGPU.h"
+#include "SweetGPU_sqe.h"
+
+#if defined(SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <pexpert/pexpert.h>
+
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern "C" void clean_dcache64(addr64_t addr, unsigned count, int phys);
+
+OSDefineMetaClassAndStructors(SweetGPU, IOService);
+
+static SweetGPU *gSweetGPU = NULL;
+
+static inline void
+gpu_wr32(uintptr_t base, uint32_t reg, uint32_t val)
+{
+	*(volatile uint32_t *)(base + (reg * 4)) = val;
+	__asm__ volatile("dmb sy" ::: "memory");
+}
+
+static inline uint32_t
+gpu_rd32(uintptr_t base, uint32_t reg)
+{
+	uint32_t val = *(volatile uint32_t *)(base + (reg * 4));
+	__asm__ volatile("dmb sy" ::: "memory");
+	return val;
+}
+
+bool
+SweetGPU::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	fPhysBase = SWEET_GPU_MMIO_PA;
+	fSize = SWEET_GPU_MMIO_SIZE;
+	fRegs = (uintptr_t)ml_io_map(fPhysBase, fSize);
+	fGmuRegs = (uintptr_t)ml_io_map(SWEET_GMU_MMIO_PA, SWEET_GMU_MMIO_SIZE);
+	fGpuccRegs = (uintptr_t)ml_io_map(SWEET_GPUCC_MMIO_PA, SWEET_GPUCC_MMIO_SIZE);
+	fLock = IOLockAlloc();
+	fReady = false;
+	int blit_enable = 1;
+	PE_parse_boot_argn("sweetgpublit", &blit_enable, sizeof(blit_enable));
+	fBlitEnabled = (blit_enable != 0);
+
+	if (fRegs == 0 || fLock == NULL) {
+		IOLog("SWEET GPU: failed to map MMIO or allocate lock\n");
+		return false;
+	}
+
+	IOLog("SWEET GPU: Adreno 618 probe @ 0x%llx (mapped %p)\n", fPhysBase, (void *)fRegs);
+
+	gSweetGPU = this;
+	registerService();
+
+	/* Attempt hardware initialization */
+	if (hwInit()) {
+		fReady = true;
+		IOLog("SWEET GPU: initialized and ready for commands!\n");
+	} else {
+		IOLog("SWEET GPU: hwInit deferred or unpowered\n");
+	}
+
+	return true;
+}
+
+void
+SweetGPU::stop(IOService *provider)
+{
+	gSweetGPU = NULL;
+	fReady = false;
+	IOService::stop(provider);
+}
+
+bool
+SweetGPU::hwInit(void)
+{
+	uint32_t status = gpu_rd32(fRegs, A6XX_RBBM_STATUS);
+	IOLog("SWEET GPU: RBBM_STATUS = 0x%08x\n", status);
+
+	if (status == 0xffffffff) {
+		IOLog("SWEET GPU: unpowered or bus clocked off (0xffffffff)\n");
+		return false;
+	}
+
+	/* Clear GBIF halt */
+	gpu_wr32(fRegs, A6XX_RBBM_GBIF_HALT, 0);
+
+	/* Turn on 64-bit addressing for all blocks */
+	gpu_wr32(fRegs, A6XX_CP_ADDR_MODE_CNTL, 1);
+	gpu_wr32(fRegs, A6XX_VSC_ADDR_MODE_CNTL, 1);
+	gpu_wr32(fRegs, A6XX_GRAS_ADDR_MODE_CNTL, 1);
+	gpu_wr32(fRegs, A6XX_RB_ADDR_MODE_CNTL, 1);
+	gpu_wr32(fRegs, A6XX_PC_ADDR_MODE_CNTL, 1);
+	gpu_wr32(fRegs, A6XX_HLSQ_ADDR_MODE_CNTL, 1);
+	gpu_wr32(fRegs, A6XX_VFD_ADDR_MODE_CNTL, 1);
+	gpu_wr32(fRegs, A6XX_VPC_ADDR_MODE_CNTL, 1);
+	gpu_wr32(fRegs, A6XX_UCHE_ADDR_MODE_CNTL, 1);
+	gpu_wr32(fRegs, A6XX_SP_ADDR_MODE_CNTL, 1);
+	gpu_wr32(fRegs, A6XX_TPL1_ADDR_MODE_CNTL, 1);
+
+	/* Allocate SQE microcode buffer (4KB aligned) */
+	uint32_t sqe_size = A630_SQE_FW_WORDS * 4;
+	fSqeDesc = IOBufferMemoryDescriptor::inTaskWithOptions(
+	    kernel_task, kIODirectionInOut | kIOMemoryPhysicallyContiguous, sqe_size, 4096);
+	if (fSqeDesc == NULL) {
+		IOLog("SWEET GPU: failed to allocate SQE buffer\n");
+		return false;
+	}
+	fSqePhys = fSqeDesc->getPhysicalAddress();
+	memcpy(fSqeDesc->getBytesNoCopy(), a630_sqe_fw, sqe_size);
+
+	/* Program SQE instruction base */
+	gpu_wr32(fRegs, A6XX_CP_SQE_INSTR_BASE_LO, (uint32_t)fSqePhys);
+	gpu_wr32(fRegs, A6XX_CP_SQE_INSTR_BASE_HI, (uint32_t)(fSqePhys >> 32));
+
+	/* Allocate ringbuffer (256 KB = 65536 words) */
+	fRingWords = 65536;
+	uint32_t ring_bytes = fRingWords * 4;
+	fRingDesc = IOBufferMemoryDescriptor::inTaskWithOptions(
+	    kernel_task, kIODirectionInOut | kIOMemoryPhysicallyContiguous, ring_bytes, 4096);
+	if (fRingDesc == NULL) {
+		IOLog("SWEET GPU: failed to allocate ringbuffer\n");
+		return false;
+	}
+	fRingPhys = fRingDesc->getPhysicalAddress();
+	fRingVirt = (volatile uint32_t *)fRingDesc->getBytesNoCopy();
+	memset((void *)fRingVirt, 0, ring_bytes);
+	fWptr = 0;
+
+	/* Setup Ringbuffer registers */
+	gpu_wr32(fRegs, A6XX_CP_RB_BASE_LO, (uint32_t)fRingPhys);
+	gpu_wr32(fRegs, A6XX_CP_RB_BASE_HI, (uint32_t)(fRingPhys >> 32));
+	/* CP_RB_CNTL: 16 = 2^16 words = 256KB buffer */
+	gpu_wr32(fRegs, A6XX_CP_RB_CNTL, 16);
+	gpu_wr32(fRegs, A6XX_CP_RB_RPTR, 0);
+	gpu_wr32(fRegs, A6XX_CP_RB_WPTR, 0);
+
+	/* Enable SQE execution */
+	gpu_wr32(fRegs, A6XX_CP_SQE_CNTL, 1);
+
+	/* Submit initial NOP packet */
+	IOLockLock(fLock);
+	ringWrite(0x70000010); /* CP_NOP: Type 7 packet, opcode 0x10, count 0 */
+	ringCommit();
+	IOLockUnlock(fLock);
+
+	return true;
+}
+
+void
+SweetGPU::ringWrite(uint32_t dword)
+{
+	fRingVirt[fWptr] = dword;
+	fWptr = (fWptr + 1) & (fRingWords - 1);
+}
+
+void
+SweetGPU::ringCommit(void)
+{
+	__asm__ volatile("dmb sy" ::: "memory");
+	gpu_wr32(fRegs, A6XX_CP_RB_WPTR, fWptr);
+}
+
+bool
+SweetGPU::waitIdle(uint32_t timeout_us)
+{
+	while (timeout_us > 0) {
+		uint32_t rptr = gpu_rd32(fRegs, A6XX_CP_RB_RPTR);
+		if (rptr == fWptr) {
+			return true;
+		}
+		IODelay(10);
+		timeout_us = (timeout_us > 10) ? (timeout_us - 10) : 0;
+	}
+	return false;
+}
+
+bool
+SweetGPU::blit(uint64_t src_phys, uint32_t src_stride, uint64_t dst_phys,
+              uint32_t dst_stride, uint32_t width, uint32_t height)
+{
+	if (!fReady || !fBlitEnabled || fRingVirt == NULL || width == 0 || height == 0) {
+		return false;
+	}
+
+	/* Clean CPU data cache so the GPU DMA sees fresh pixel data */
+	clean_dcache64((addr64_t)src_phys, (unsigned)(height * src_stride), 1);
+
+	IOLockLock(fLock);
+
+	static uint32_t blit_logged = 0;
+	if (blit_logged < 5) {
+		blit_logged++;
+		IOLog("SWEET GPU: blit #%u src=0x%llx (%u) dst=0x%llx (%u) %ux%u\n",
+		    blit_logged, src_phys, src_stride, dst_phys, dst_stride, width, height);
+	}
+
+	uint32_t dwords_per_line = width;
+
+	if (src_stride == dst_stride && width * 4 == src_stride) {
+		/* Full contiguous frame: chunk into <= 256K dwords */
+		uint32_t total_dwords = width * height;
+		uint32_t max_chunk = 262144;
+		uint32_t offset = 0;
+		while (offset < total_dwords) {
+			uint32_t cur = total_dwords - offset;
+			if (cur > max_chunk) cur = max_chunk;
+			uint64_t s = src_phys + (uint64_t)offset * 4;
+			uint64_t d = dst_phys + (uint64_t)offset * 4;
+			ringWrite(0x70050075); /* CP_MEMCPY */
+			ringWrite((uint32_t)s);
+			ringWrite((uint32_t)(s >> 32));
+			ringWrite((uint32_t)d);
+			ringWrite((uint32_t)(d >> 32));
+			ringWrite(cur);
+			offset += cur;
+		}
+	} else {
+		/* Row by row */
+		for (uint32_t y = 0; y < height; y++) {
+			uint64_t s = src_phys + (uint64_t)y * src_stride;
+			uint64_t d = dst_phys + (uint64_t)y * dst_stride;
+			ringWrite(0x70050075); /* CP_MEMCPY */
+			ringWrite((uint32_t)s);
+			ringWrite((uint32_t)(s >> 32));
+			ringWrite((uint32_t)d);
+			ringWrite((uint32_t)(d >> 32));
+			ringWrite(dwords_per_line);
+		}
+	}
+
+	ringCommit();
+
+	/* Wait for GPU to finish copying */
+	bool idle = waitIdle(20000); /* 20ms */
+	if (!idle) {
+		uint32_t rptr = gpu_rd32(fRegs, A6XX_CP_RB_RPTR);
+		uint32_t status = gpu_rd32(fRegs, A6XX_RBBM_STATUS);
+		IOLog("SWEET GPU: blit timeout (wptr=%u rptr=%u status=0x%08x) - disabling GPU blit\n",
+		    fWptr, rptr, status);
+		fBlitEnabled = false;
+		IOLockUnlock(fLock);
+		return false;
+	}
+
+	IOLockUnlock(fLock);
+	return true;
+}
+
+bool
+sweet_gpu_is_ready(void)
+{
+	return gSweetGPU != NULL && gSweetGPU->fReady && gSweetGPU->fBlitEnabled;
+}
+
+bool
+sweet_gpu_blit(uint64_t src_phys, uint32_t src_stride, uint64_t dst_phys,
+               uint32_t dst_stride, uint32_t width, uint32_t height)
+{
+	if (gSweetGPU == NULL) {
+		return false;
+	}
+	return gSweetGPU->blit(src_phys, src_stride, dst_phys, dst_stride, width, height);
+}
+
+#endif /* SWEET */
diff -uNr xnu-buildtree/orig/xnu/iokit/Kernel/arm/SweetGPU.h xnu-buildtree/tree/xnu/iokit/Kernel/arm/SweetGPU.h
--- a/iokit/Kernel/arm/SweetGPU.h
+++ b/iokit/Kernel/arm/SweetGPU.h
@@ -0,0 +1,102 @@
+/*
+ * Built-in Adreno 618 GPU driver for SWEET (Qualcomm SM7150 / Snapdragon 732G).
+ *
+ * Initializes the Adreno 6xx command processor, loads the SQE microcode,
+ * sets up 64-bit address mode, allocates a ringbuffer, and accelerates
+ * 2D composition / blits to the display panel memory.
+ */
+#ifndef _SWEET_GPU_H
+#define _SWEET_GPU_H
+
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOLocks.h>
+#include <libkern/c++/OSObject.h>
+
+#define SWEET_GPU_MMIO_PA       0x05000000ULL
+#define SWEET_GPU_MMIO_SIZE     0x00040000ULL
+#define SWEET_GMU_MMIO_PA       0x0506a000ULL
+#define SWEET_GMU_MMIO_SIZE     0x00031000ULL
+#define SWEET_GPUCC_MMIO_PA     0x05090000ULL
+#define SWEET_GPUCC_MMIO_SIZE   0x00009000ULL
+
+/* Adreno 6xx register dword offsets (multiplied by 4 for byte offset) */
+#define A6XX_RBBM_STATUS                        0x0210
+#define A6XX_RBBM_STATUS3                       0x0213
+#define A6XX_RBBM_INT_0_STATUS                  0x0201
+#define A6XX_RBBM_INT_0_MASK                    0x0202
+#define A6XX_RBBM_GBIF_HALT                     0x0016
+#define A6XX_RBBM_GBIF_HALT_ACK                 0x0017
+#define A6XX_RBBM_SECVID_TSB_CNTL               0x0f800
+#define A6XX_RBBM_SECVID_TSB_TRUSTED_BASE_LO    0x0f801
+#define A6XX_RBBM_SECVID_TSB_TRUSTED_BASE_HI    0x0f802
+#define A6XX_RBBM_SECVID_TSB_TRUSTED_SIZE       0x0f803
+
+#define A6XX_CP_RB_BASE_LO                      0x0800
+#define A6XX_CP_RB_BASE_HI                      0x0801
+#define A6XX_CP_RB_CNTL                         0x0802
+#define A6XX_CP_RB_RPTR_ADDR_LO                 0x0804
+#define A6XX_CP_RB_RPTR_ADDR_HI                 0x0805
+#define A6XX_CP_RB_RPTR                         0x0806
+#define A6XX_CP_RB_WPTR                         0x0807
+#define A6XX_CP_SQE_CNTL                        0x0808
+#define A6XX_CP_SQE_INSTR_BASE_LO               0x0830
+#define A6XX_CP_SQE_INSTR_BASE_HI               0x0831
+#define A6XX_CP_ADDR_MODE_CNTL                  0x0842
+
+/* Other block 64-bit address mode registers */
+#define A6XX_VSC_ADDR_MODE_CNTL                 0x0c01
+#define A6XX_GRAS_ADDR_MODE_CNTL                0x0860
+#define A6XX_RB_ADDR_MODE_CNTL                  0x08e0
+#define A6XX_PC_ADDR_MODE_CNTL                  0x09e0
+#define A6XX_HLSQ_ADDR_MODE_CNTL                0x0980
+#define A6XX_VFD_ADDR_MODE_CNTL                 0x0a60
+#define A6XX_VPC_ADDR_MODE_CNTL                 0x0960
+#define A6XX_UCHE_ADDR_MODE_CNTL                0x0e00
+#define A6XX_SP_ADDR_MODE_CNTL                  0x0b60
+#define A6XX_TPL1_ADDR_MODE_CNTL                0x0f00
+
+class SweetGPU : public IOService {
+	OSDeclareDefaultStructors(SweetGPU);
+
+public:
+	uint64_t                  fPhysBase;
+	uint32_t                  fSize;
+	uintptr_t                 fRegs;
+	uintptr_t                 fGmuRegs;
+	uintptr_t                 fGpuccRegs;
+	IOLock                   *fLock;
+	bool                      fReady;
+	bool                      fBlitEnabled;
+
+	IOBufferMemoryDescriptor *fSqeDesc;
+	uint64_t                  fSqePhys;
+
+	IOBufferMemoryDescriptor *fRingDesc;
+	uint64_t                  fRingPhys;
+	volatile uint32_t        *fRingVirt;
+	uint32_t                  fRingWords;
+	uint32_t                  fWptr;
+
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+
+	bool hwInit(void);
+	void ringWrite(uint32_t dword);
+	void ringCommit(void);
+	bool waitIdle(uint32_t timeout_us);
+
+	bool blit(uint64_t src_phys, uint32_t src_stride, uint64_t dst_phys,
+	          uint32_t dst_stride, uint32_t width, uint32_t height);
+};
+
+/* Global functions for SweetFramebuffer */
+bool sweet_gpu_is_ready(void);
+bool sweet_gpu_blit(uint64_t src_phys, uint32_t src_stride, uint64_t dst_phys,
+                    uint32_t dst_stride, uint32_t width, uint32_t height);
+
+#endif /* SWEET */
+#endif /* _SWEET_GPU_H */
